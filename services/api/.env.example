# --- Database ---
DATABASE_URL="postgresql://rajarani:password@localhost:5432/rajarani_dev"

# --- Auth ---
JWT_ACCESS_SECRET="replace-with-32+char-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="replace-with-a-different-32+char-random-string"
JWT_REFRESH_TTL="30d"

# --- OTP (SMS provider — pick one and fill in) ---
SMS_PROVIDER="msg91"        # or "twilio"
SMS_API_KEY=""
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"

# --- Google Sign-In (OAuth 2.0 client ID from Google Cloud Console —
#     create one Web client ID and use it for both the backend token
#     verification and the mobile app's google_sign_in config) ---
GOOGLE_CLIENT_ID=""

# --- Payments (Razorpay — web/eligible flows only; see PAYMENTS.md
#     for why Play Billing is required for in-app digital purchases) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Video (choose one provider; Cloudflare Stream shown) ---
VIDEO_PROVIDER="cloudflare_stream"
CF_ACCOUNT_ID=""
CF_STREAM_API_TOKEN=""

# --- Push notifications ---
FCM_SERVICE_ACCOUNT_JSON_PATH="./secrets/fcm-service-account.json"

# --- Object storage (thumbnails, PDFs, banners) ---
STORAGE_PROVIDER="cloudflare_r2"   # or "s3"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# --- App ---
PORT="4000"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
